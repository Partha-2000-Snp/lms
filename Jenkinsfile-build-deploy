pipeline {
    agent {lms-fe}
    stages {
        stage('build lms frontend') {
            steps {
                echo 'build lms frontend starting'
                sh 'cd webapp && npm install && npm run build'
                echo 'build done'
            }
        }
        stage('deploy lms frontend') {
            steps {
                echo 'starting deployment'
                sh 'cd webapp/dist/'
                sh 'sudo cp -r dist/* /var/www/html'
                echo 'deployment done'
            }
        }
    }
}